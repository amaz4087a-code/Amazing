# --- Database (PostgreSQL - Supabase) ---
# Pooled connection (port 6543 with pgbouncer) for Prisma / app
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) for migrations
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require"

# --- NextAuth ---
NEXTAUTH_URL="https://your-app.vercel.app"
NEXTAUTH_SECRET="generate-a-random-secret-here"

# --- Vercel Blob (file storage) ---
# Get from: Vercel Dashboard > Storage > Create Blob
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxx"
