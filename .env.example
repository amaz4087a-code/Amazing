# ─── Database (PostgreSQL — e.g. Supabase) ─────────────────
# Get this from your Supabase project → Project Settings → Database → Connection string (pooled)
DATABASE_URL="postgresql://postgres:password@db.example.supabase.co:6543/postgres?pgbouncer=true"
# Direct connection for Prisma migrations (use port 5432, not pooled)
DIRECT_URL="postgresql://postgres:password@db.example.supabase.co:5432/postgres"

# ─── NextAuth ─────────────────────────────────────────────
NEXTAUTH_URL="https://your-app.vercel.app"
NEXTAUTH_SECRET="generate-a-random-string-here"

# ─── Vercel Blob (file storage) ───────────────────────────
# Create a token in Vercel Dashboard → Storage → Blob → Create token
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxx"
